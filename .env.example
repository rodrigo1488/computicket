# Copie para .env na raiz (opcional). Usado pelo docker compose.

# Portas no HOST — Postgres NÃO usa 5432 (reservado ao Uniplus/ERP)
COMPUTICKET_WEB_PORT=3000
COMPUTICKET_API_PORT=5000
COMPUTICKET_WHATSAPP_PORT=4000
COMPUTICKET_PG_PORT=15432
COMPUTICKET_REDIS_PORT=16379

# URL que os clientes conseguem abrir (usada no link da pesquisa via WhatsApp
# e como origem do Socket.IO do helpdesk quando WHATSAPP_ENGINE_PUBLIC_URL está vazia).
# Em produção: https://computicket.space — nunca localhost nem whatsapp-engine.
COMPUTICKET_PUBLIC_URL=http://localhost:3000

COMPUTICKET_DB_USER=computicket
COMPUTICKET_DB_PASS=computicket
COMPUTICKET_APP_DB=computicket
COMPUTICKET_WHATSAPP_DB=computicket_whatsapp

SECRET_KEY=altere-este-segredo-em-producao

WHATSAPP_JWT_SECRET=computicket-whatsapp-jwt-dev-secret
WHATSAPP_JWT_REFRESH_SECRET=computicket-whatsapp-refresh-dev-secret
WHATSAPP_ENGINE_ADMIN_EMAIL=admin@admin.com
WHATSAPP_ENGINE_ADMIN_PASSWORD=123456

# Socket.IO no browser (helpdesk). Deixe vazio para usar COMPUTICKET_PUBLIC_URL
# (same-origin: Next faz proxy de /socket.io → whatsapp-engine).
# Produção recomendado: https://computicket.space
# NÃO use http://whatsapp-engine:4000 (hostname só existe na rede Docker).
# WHATSAPP_ENGINE_PUBLIC_URL=https://computicket.space

# Web Push: opcional. Sem estas variáveis, a API gera e persiste automaticamente
# as chaves no volume computicket_api_instance durante a primeira inicialização.
# Para usar chaves próprias: `python api/generate_vapid_keys.py`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@computicket.local

# Uniplus agente: preferir Configurações → Uniplus na UI
# UNIPLUS_AGENT_ENABLED=0
