# Copie para .env na raiz (opcional). Usado pelo docker compose.

# Portas no HOST — Postgres NÃO usa 5432 (reservado ao Uniplus/ERP)
COMPUTICKET_WEB_PORT=3000
COMPUTICKET_API_PORT=5000
COMPUTICKET_WHATSAPP_PORT=4000
COMPUTICKET_PG_PORT=15432
COMPUTICKET_REDIS_PORT=16379

COMPUTICKET_PUBLIC_URL=http://localhost:3000

COMPUTICKET_DB_USER=computicket
COMPUTICKET_DB_PASS=computicket
COMPUTICKET_APP_DB=computicket
COMPUTICKET_WHATSAPP_DB=computicket_whatsapp

SECRET_KEY=altere-este-segredo-em-producao

WHATSAPP_JWT_SECRET=computicket-whatsapp-jwt-dev-secret
WHATSAPP_JWT_REFRESH_SECRET=computicket-whatsapp-refresh-dev-secret
WHATSAPP_ENGINE_ADMIN_EMAIL=admin@admin.com
WHATSAPP_ENGINE_ADMIN_PASSWORD=123456

# Uniplus agente: preferir Configurações → Uniplus na UI
# UNIPLUS_AGENT_ENABLED=0
