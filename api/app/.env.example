# Copie para .env e ajuste conforme o ambiente.
# Sem SQLALCHEMY_DATABASE_URI a app usa SQLite em instance/tickets.sqlite3.

# Postgres dedicado do app — porta HOST 15432 (não 5432; 5432 = Uniplus)
# Com API no Docker use host "postgres" (já definido no compose).
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://computicket:computicket@localhost:15432/computicket

# Agente Uniplus — preferencial: Configurações → Uniplus na UI (SystemConfig).
# Env abaixo só vale se a chave correspondente ainda não estiver salva no banco.
# 0 = legado (API conecta direto no Postgres unico)
UNIPLUS_AGENT_ENABLED=0
UNIPLUS_AGENT_DEVICE_ID=uniplus-server-1
UNIPLUS_AGENT_TOKEN=altere-este-segredo

# Postgres Unico (host/credenciais): configure em Configurações → Uniplus na UI.
# Não use UNICO_PG_* no .env — a API lê só SystemConfig (uniplus_pg_*).

# GEMINI_API_KEY=
